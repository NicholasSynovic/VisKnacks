# Pinned tool versions for the integration tests.
#
# The tests exercise exact OpenCode server API response shapes and
# Ollama endpoints, so both versions must match exactly. The renderer
# stages additionally depend on the ParaView build and the Python mcp
# package (the server's /mcp redirect behavior is an mcp-package
# trait). Re-pin by editing this file only; a mismatch exits 2 before
# any test runs.

OPENCODE_REQUIRED_VERSION="2.2.7"
OLLAMA_REQUIRED_VERSION="0.40.14"
PARAVIEW_REQUIRED_VERSION="6.1.1"
MCP_REQUIRED_VERSION="1.9.4"
