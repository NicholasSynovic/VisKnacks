# pvpython-renderer MCP server — headless ParaView Apptainer image.
#
# Build (from this directory; %files paths are CWD-relative):
#   apptainer build --fakeroot pvpython-renderer.sif apptainer.def
#
# Run:
#   apptainer run pvpython-renderer.sif
#   apptainer run pvpython-renderer.sif --server 0.0.0.0 --port 9090
#
# The MCP endpoint is then at http://localhost:8080/mcp
#
# Rendering is software-only (Mesa llvmpipe via the ParaView `osmesa`
# build); no GPU, X server, or host driver is required. See
# `environment.container.yaml` for why this differs from `environment.yaml`.
#
# This mirrors `Dockerfile`, minus the constructs that are meaningless in
# Apptainer: USER/useradd (the container runs as the invoking host user),
# ENV HOME (a SIF is read-only; the host $HOME is bound rw instead),
# VOLUME, EXPOSE, and HEALTHCHECK (no equivalents).

Bootstrap: docker
From: condaforge/miniforge3:24.11.3-2

%files
    environment.container.yaml /tmp/environment.container.yaml
    pyproject.toml             /app/pyproject.toml
    README.md                  /app/README.md
    pvpython_renderer/         /app/pvpython_renderer/

%post
    set -eu

    # `paraview` is conda-only (it cannot be pip-installed), so the conda
    # env IS the runtime: its Python 3.10 interpreter is what the console
    # script runs on.
    conda env create --file /tmp/environment.container.yaml
    conda clean --all --yes
    rm -f /tmp/environment.container.yaml

    # Unlike Dockerfile ENV, %environment is NOT in effect during %post,
    # so PATH must be exported here as well for the steps below.
    export PATH=/opt/conda/envs/pvpython_renderer/bin:$PATH

    # Force the software GL path. The osmesa build has no hardware driver
    # to fall back to, and these make that explicit rather than implicit.
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe

    # Fail the build loudly if the osmesa package does not actually
    # provide a working headless pvserver/pvpython pair, rather than
    # shipping an image that only breaks on the first execute_code call.
    pvserver --version
    pvpython -c "from paraview.simple import *; print('paraview.simple OK')"

    # Non-editable install; the dev dependency group is intentionally
    # skipped. This registers the `pvpython-renderer-mcp` console script.
    cd /app
    pip install --no-cache-dir .
    python -c "import pvpython_renderer.pv_mcp"

    # There is no USER directive in Apptainer: the container runs as the
    # unprivileged host user who invoked it, while %post ran as root.
    # Guarantee everything installed above is world-readable/traversable.
    chmod -R a+rX /opt/conda /app

    # Mountpoint for an optional explicit log bind. Not required: logs
    # default to the host $HOME, which Apptainer binds read-write.
    mkdir -p /logs

%environment
    # Put the env's bin on PATH rather than relying on `conda activate`.
    # This is load-bearing: pv_mcp.py resolves the ParaView binaries with
    # shutil.which("pvpython") / shutil.which("pvserver") at call time, so
    # they must be on PATH of the server process and of every subprocess
    # it spawns. Prepending also shadows any host pvpython that leaks in
    # via the inherited environment.
    export PATH=/opt/conda/envs/pvpython_renderer/bin:$PATH
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe

    # Deliberately NOT setting HOME. The Docker image pinned it to
    # /home/pvuser, but a SIF is read-only and Apptainer already binds the
    # host $HOME read-write. logger.py writes ~/paraview_logs and pv_mcp.py
    # writes the per-call runner/pvserver logs beside it; both land on the
    # host, survive restarts, and stay directly readable.

%runscript
    # Default to localhost, unlike the Docker CMD's 0.0.0.0. Apptainer
    # shares the host network namespace, so loopback is already reachable
    # from the host and there is no port to publish. Binding 0.0.0.0 by
    # default would expose an arbitrary-code-execution endpoint to the
    # network. Pass `--server 0.0.0.0` explicitly if that is wanted.
    if [ "$#" -eq 0 ]; then
        set -- --server "${PVR_HOST:-localhost}" --port "${PVR_PORT:-8080}"
    fi
    exec pvpython-renderer-mcp "$@"

%test
    set -eu
    export PATH=/opt/conda/envs/pvpython_renderer/bin:$PATH
    pvserver --version
    pvpython -c "from paraview.simple import *; print('paraview.simple OK')"
    python -c "import pvpython_renderer.pv_mcp; print('pv_mcp OK')"

%labels
    org.opencontainers.image.title       pvpython-renderer
    org.opencontainers.image.description ParaView headless rendering MCP server
    io.scivisagent.paraview.version      5.13.3
    io.scivisagent.paraview.build        osmesa

%help
    pvpython-renderer — MCP server exposing a single `execute_code` tool
    over streamable-http. Each call spawns an ephemeral reverse-connected
    pvserver, runs paraview.simple code in it, and tears it down.

    Run:
        apptainer run pvpython-renderer.sif
        apptainer run pvpython-renderer.sif --server 0.0.0.0 --port 9090

    Endpoint:
        http://localhost:8080/mcp

    Logs (on the host, via the default $HOME bind):
        ~/paraview_logs/pvpython_renderer_external.log
        ~/paraview_logs/call_<timestamp>_runner.log
        ~/paraview_logs/call_<timestamp>_pvserver.log

    To relocate logs, bind another directory over the home path, e.g.
        apptainer run --bind /scratch/logs:$HOME/paraview_logs ...

    Notes:
      - Rendering is CPU-only (Mesa llvmpipe). No --nv is needed or used.
      - Do NOT use --contain / --no-home: the server needs a writable
        $HOME for its log directory.
      - Each execute_code call picks an ephemeral localhost port for the
        pvserver reverse connection. Apptainer shares the host network
        namespace, so that port is allocated on the host.
