# pvpython-rag MCP server — FAISS retrieval over the ParaView Python API.
#
# !! REQUIRES AN NVIDIA GPU !!
#   rag_mcp.py hardcodes device="cuda" with no CPU fallback, so the
#   container exits non-zero at startup without a GPU. Run with `--nv`.
#
# !! LARGE IMAGE !!
#   environment.yaml is a full `conda env export` freeze pinning torch,
#   the nvidia-* CUDA 13 wheels, conda libtorch, and cuda-toolkit. Point
#   APPTAINER_TMPDIR at a filesystem with tens of GB free before building.
#
# This image is SERVE-ONLY. Building indexes (scripts/build_all_indexes.sh)
# needs a ParaView git clone and stays a host-side task; bind the
# resulting indexes at /data.
#
# Build (from this directory; %files paths are CWD-relative):
#   APPTAINER_TMPDIR=/var/tmp apptainer build --fakeroot \
#       pvpython-rag.sif apptainer.def
#
# Run:
#   apptainer run --nv --bind "$(pwd)/data/vector-db:/data:ro" \
#       pvpython-rag.sif
#
# The MCP endpoint is then at http://localhost:8081/mcp
#
# This mirrors `Dockerfile`, minus the constructs that are meaningless in
# Apptainer: USER/useradd (the container runs as the invoking host user),
# VOLUME, EXPOSE, and HEALTHCHECK (no equivalents).

Bootstrap: docker
From: condaforge/miniforge3:24.11.3-2

%files
    environment.yaml /tmp/environment.yaml
    pyproject.toml   /app/pyproject.toml
    README.md        /app/README.md
    pvpython_rag/    /app/pvpython_rag/

%post
    set -eu

    # environment.yaml pins packages (faiss, numpy, libtorch, ...) that
    # resolve from Anaconda's `defaults` channel rather than conda-forge,
    # so the solve below depends on it. Newer conda ships the
    # `conda-anaconda-tos` plugin, which refuses to install from
    # `defaults` until its Terms of Service are accepted; the conda in
    # this base image predates that plugin and needs no acceptance.
    # Accept it only when the subcommand exists, so the build works both
    # today and after a base-image bump.
    #
    # Note: using `defaults` carries Anaconda's ToS/licensing terms, which
    # may have commercial-use implications when redistributing this image.
    # Switch environment.yaml to a conda-forge-only spec to avoid them.
    if conda tos --help >/dev/null 2>&1; then
        conda tos accept --override-channels \
            --channel https://repo.anaconda.com/pkgs/main \
            --channel https://repo.anaconda.com/pkgs/r
    else
        echo "conda tos plugin not present; skipping ToS acceptance"
    fi

    # The conda env IS the runtime. Note that pyproject.toml declares only
    # `fastmcp`, while the code imports faiss, numpy, and
    # sentence_transformers — those come from environment.yaml, so it is
    # not optional.
    #
    # CONDA_OVERRIDE_CUDA is required: environment.yaml pins the CUDA
    # builds of faiss/libfaiss, which depend on the `__cuda` virtual
    # package. Conda derives `__cuda` from the *host driver*, which is not
    # visible during the build (there is no --nv at build time), so the
    # solve fails with "nothing provides __cuda" on any builder — even a
    # GPU machine. Asserting the version here only affects dependency
    # resolution, not what is linked at runtime; it must be >= the CUDA
    # version the pinned packages target (cuda130 -> 13.0).
    CONDA_OVERRIDE_CUDA=13.0 conda env create --file /tmp/environment.yaml
    conda clean --all --yes
    rm -f /tmp/environment.yaml

    # %environment is NOT in effect during %post; export PATH here too.
    export PATH=/opt/conda/envs/pvpython_rag/bin:$PATH

    # --no-deps: environment.yaml already froze every runtime dependency
    # at an exact version. Letting pip re-resolve `fastmcp` here would
    # risk pulling a different transitive set over the pinned one.
    cd /app
    pip install --no-cache-dir --no-deps .
    python -c "import pvpython_rag.rag_mcp"

    # No USER directive in Apptainer: %post runs as root, the container
    # runs as the unprivileged invoking user. Make the install readable.
    chmod -R a+rX /opt/conda /app

    # Bind target for the prebuilt index_<tag>.faiss + metadata_<tag>.json
    # pairs. Must exist in the image: a read-only SIF cannot have bind
    # points created on the fly.
    mkdir -p /data

%environment
    # Put the env's bin on PATH rather than relying on `conda activate`.
    export PATH=/opt/conda/envs/pvpython_rag/bin:$PATH

    # Model weights (nomic-ai/CodeRankEmbed) are downloaded on first
    # start. The Docker image cached them at /cache/huggingface, but a SIF
    # is read-only, so that path would fail without an explicit bind.
    # Default to the host $HOME cache instead (Apptainer binds $HOME rw),
    # which makes a bare `apptainer run --nv` work and shares the cache
    # with any host-side use. Respects an inherited HF_HOME if set.
    export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"

%runscript
    # Default to localhost, unlike the Docker CMD's 0.0.0.0: Apptainer
    # shares the host network namespace, so there is no port to publish
    # and loopback is already reachable from the host.
    #
    # --directory is a required argument of pvpython-rag-mcp and must
    # point at the bound indexes. Note that supplying ANY argument
    # replaces the whole default set, so a custom invocation must pass
    # --directory itself.
    if [ "$#" -eq 0 ]; then
        set -- --host "${PVRAG_HOST:-localhost}" \
               --port "${PVRAG_PORT:-8081}" \
               --directory "${PVRAG_DATA:-/data}"
    fi
    exec pvpython-rag-mcp "$@"

%test
    set -eu
    export PATH=/opt/conda/envs/pvpython_rag/bin:$PATH
    # Import-only. Deliberately does not touch CUDA or load the embedding
    # model: no GPU is available during `apptainer build`.
    python -c "import faiss, numpy, sentence_transformers; print('deps OK')"
    python -c "import pvpython_rag.rag_mcp; print('rag_mcp OK')"

%labels
    org.opencontainers.image.title       pvpython-rag
    org.opencontainers.image.description FAISS RAG MCP server over the ParaView Python API
    io.scivisagent.gpu.required          true
    io.scivisagent.embedding.model       nomic-ai/CodeRankEmbed

%help
    pvpython-rag — MCP server exposing a single `query` tool over
    streamable-http, doing FAISS retrieval across the ParaView Python API.

    REQUIRES AN NVIDIA GPU. rag_mcp.py hardcodes device="cuda" with no CPU
    fallback; without `--nv` the server exits non-zero at startup.

    Prerequisite — build the indexes on the host first:
        make create-vector-databases     # writes data/vector-db/

    Run:
        apptainer run --nv \
            --bind "$(pwd)/data/vector-db:/data:ro" \
            pvpython-rag.sif

    Endpoint:
        http://localhost:8081/mcp

    Model weights are cached in $HF_HOME (default ~/.cache/huggingface on
    the host) and downloaded on first start; the first run needs network
    access and takes several minutes.

    Serving a different ParaView version (any explicit argument replaces
    the full default set, so --directory must be repeated):
        apptainer run --nv --bind ... pvpython-rag.sif \
            --host localhost --port 8081 --directory /data \
            --pv-version 5.12.1
